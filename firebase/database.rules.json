{
  "rules": {
    ".read": false,
    ".write": false,
    "rq": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "rm": {
      "$mid": {
        "meta": {
          ".read": "auth != null && data.child('players').child(auth.uid).exists()"
        },
        "p": {
          ".read": "auth != null && root.child('rm').child($mid).child('meta/players').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rm').child($mid).child('meta/players').child($uid).exists()",
            ".validate": "newData.hasChildren(['x', 'y', 't']) && newData.child('x').isNumber() && newData.child('y').isNumber() && newData.child('t').isNumber()",
            "x": {
              ".validate": "newData.val() >= -50 && newData.val() <= 410"
            },
            "y": {
              ".validate": "newData.val() >= -50 && newData.val() <= 600"
            },
            "t": {
              ".validate": "newData.val() >= 0 && newData.val() <= 30000"
            },
            "dead": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
