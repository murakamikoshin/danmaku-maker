rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }

    // ステージ: 公開中のものは誰でも読める。「URLを知っている人だけ」(unlisted)のものは、IDを指定した1件の取得だけできて、一覧には出ない。
    // 書き込みはすべて Cloud Functions 経由
    function isOpen(stageId) {
      return get(/databases/$(database)/documents/stages/$(stageId)).data.status in ['published', 'unlisted'];
    }
    match /stages/{stageId} {
      allow get: if resource.data.status in ['published', 'unlisted'] || (signedIn() && resource.data.authorUid == request.auth.uid);
      allow list: if resource.data.status == 'published' || (signedIn() && resource.data.authorUid == request.auth.uid);
      allow write: if false;

      match /likes/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      // ランキング: 公開中のステージのものは、ログイン済み(匿名も可)なら誰でも読める。書き込みは Cloud Functions だけ
      match /scores/{uid} {
        allow read: if signedIn() && isOpen(stageId);
        allow write: if false;
      }

      // コメント: 公開中のステージの、非表示になっていないものだけ読める。書き込みは Cloud Functions だけ
      match /comments/{commentId} {
        allow read: if signedIn() && resource.data.status == 'published'
          && isOpen(stageId);
        allow write: if false;
      }
    }

    // ユーザー: 自分の表示名とブロックリストだけ自分で更新できる
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'blockedUids', 'createdAt', 'postCount'])
        && request.resource.data.postCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.blockedUids is list && request.resource.data.blockedUids.size() <= 500
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 12;
      allow update: if isMember() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'blockedUids'])
        && request.resource.data.blockedUids is list && request.resource.data.blockedUids.size() <= 500
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 12;
      allow delete: if false;
    }

    // マイステージのバックアップ(アプリを入れ直したときに戻す)。本人(匿名も可)だけが読み書きできる
    match /users/{uid}/savedStages/{stageId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000
        && request.resource.data.updatedAt is timestamp;
    }

    // 通知を受け取る端末(トークン・言語・種類ごとのオン/オフ)。本人だけが読み書きできる。送るのは Cloud Functions
    match /users/{uid}/pushDevices/{deviceId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'lang', 'enabled', 'likes', 'comments', 'plays', 'updatedAt'])
        && request.resource.data.token is string && request.resource.data.token.size() < 4096
        && request.resource.data.lang is string && request.resource.data.lang.size() < 32
        && request.resource.data.enabled is bool && request.resource.data.likes is bool
        && request.resource.data.comments is bool && request.resource.data.plays is bool
        && request.resource.data.updatedAt is timestamp;
    }

    // 通報・リプレイ・管理者向けアラートはクライアントから一切触れない
    match /reports/{id} { allow read, write: if false; }
    match /stageReplays/{id} { allow read, write: if false; }
    match /scoreReplays/{id} { allow read, write: if false; }
    match /scoreMeta/{id} { allow read, write: if false; }
    match /commentMeta/{id} { allow read, write: if false; }
    match /commentReports/{id} { allow read, write: if false; }
    match /admin_alerts/{id} { allow read, write: if false; }

    // スワイプ弾幕: 候補の一覧とランキングは、ログイン済み(匿名も可)なら読める。書き込みは Cloud Functions だけ
    match /swipePools/{doc=**} { allow read: if signedIn(); allow write: if false; }
    match /swipeScores/{uid} { allow read: if signedIn(); allow write: if false; }
    match /swipeRuns/{id} { allow read, write: if false; }
    match /swipeEvents/{id} { allow read, write: if false; }
    match /swipeMismatches/{id} { allow read, write: if false; }

    // 称号: 持っている称号と付けている称号は本人だけが読める。名前の横に出す分(公開のプロフィール)は、ログイン済みなら誰でも読める。書き込みは Cloud Functions だけ
    match /inviteState/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /invites/{uid} { allow read, write: if false; }
    match /inviteCodes/{code} { allow read, write: if false; }
    match /titleState/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /publicProfiles/{uid} { allow read: if signedIn(); allow write: if false; }

    // 要望(アプリの「要望を送る」)は、クライアントから一切触れない。書き込みは Cloud Functions だけ
    match /feedback/{id} { allow read, write: if false; }
    match /feedbackLimits/{id} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
