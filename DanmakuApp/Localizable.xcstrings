    "editor.life.note.hp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each bullet that hits costs 1 HP and disappears. There is no invincibility time. At zero you fail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弾に当たるたびにHPが1減り、当たった弾は消えます。無敵時間はありません。0になったら失敗です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每被子弹击中扣 1 HP,子弹会消失。没有无敌时间。降到 0 即失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每被子彈擊中扣 1 HP,子彈會消失。沒有無敵時間。降到 0 即失敗。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탄에 맞을 때마다 HP가 1 줄고 탄은 사라져요. 무적 시간은 없어요. 0이 되면 실패예요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada bala que te alcanza resta 1 HP y desaparece. No hay tiempo de invencibilidad. Si llegas a cero, pierdes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque projectile qui vous touche coûte 1 PV et disparaît. Il n'y a pas d'invincibilité. À zéro, c'est perdu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Kugel, die dich trifft, kostet 1 HP und verschwindet. Es gibt keine Unverwundbarkeit. Bei null scheiterst du."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada bala que acerta custa 1 HP e desaparece. Não há tempo de invencibilidade. Em zero, você falha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая попавшая пуля отнимает 1 HP и исчезает. Времени неуязвимости нет. При нуле вы проигрываете."
          }
        }
      }
    },
    "editor.life.note.lives": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each hit costs one life, then you're invincible for 2 seconds. At zero you fail. With 1 life, a single hit ends the run."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "当たるとライフが1つ減って、2秒だけ無敵になります。0になったら失敗。1にすると、1回当たったら終わりです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每被击中失去 1 条命,之后有 2 秒无敌时间。降到 0 即失败。只有 1 条命时,被击中一次就结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每被擊中失去 1 條命,之後有 2 秒無敵時間。降到 0 即失敗。只有 1 條命時,被擊中一次就結束。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맞을 때마다 목숨이 1개 줄고, 이후 2초간 무적이에요. 0이 되면 실패예요. 목숨이 1개면 한 번 맞는 순간 끝나요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada golpe cuesta una vida y después eres invencible 2 segundos. Si llegas a cero, pierdes. Con 1 vida, un solo golpe termina la partida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque coup coûte une vie, puis vous êtes invincible 2 secondes. À zéro, c'est perdu. Avec 1 vie, un seul coup met fin à la partie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Treffer kostet ein Leben, danach bist du 2 Sekunden unverwundbar. Bei null scheiterst du. Mit 1 Leben beendet ein einziger Treffer den Versuch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada acerto custa uma vida, e depois você fica invencível por 2 segundos. Em zero, você falha. Com 1 vida, um único acerto encerra a partida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое попадание отнимает одну жизнь, затем вы неуязвимы 2 секунды. При нуле вы проигрываете. С 1 жизнью одно попадание заканчивает забег."
          }
        }
      }
    },
