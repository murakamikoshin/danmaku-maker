    "shop.shot.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Owned shots can be picked when creating a stage. The creator decides it per stage, so everyone plays with the same shot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買った撃ち方は、ステージ作りで選べます。撃ち方はステージごとに作る人が決めて、遊ぶ人は全員同じになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拥有的射击方式可在创建关卡时选择。由作者按关卡决定,因此所有人使用相同的射击方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已擁有的射擊方式可在建立關卡時選擇。由作者按關卡決定,因此所有人使用相同的射擊方式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보유한 샷은 스테이지를 만들 때 고를 수 있어요. 스테이지마다 제작자가 정하므로 모두 같은 샷으로 플레이해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los disparos que tengas se pueden elegir al crear un nivel. Lo decide el creador en cada nivel, así que todos juegan con el mismo disparo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tirs que vous possédez peuvent être choisis à la création d'un niveau. Le créateur décide pour chaque niveau, donc tout le monde joue avec le même tir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schüsse, die du besitzt, kannst du beim Erstellen eines Levels wählen. Der Ersteller entscheidet pro Level, damit alle mit demselben Schuss spielen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tiros que você possui podem ser escolhidos ao criar uma fase. O criador decide por fase, então todos jogam com o mesmo tiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имеющиеся виды стрельбы можно выбрать при создании уровня. Автор решает для каждого уровня, поэтому все играют с одним и тем же выстрелом."
          }
        }
      }
    },
