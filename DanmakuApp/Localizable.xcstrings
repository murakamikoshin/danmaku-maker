      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go back to how it was?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集前の状態に戻しますか?"
          }
        }
      }
    },
    "editor.revert.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Returns to how the stage was when you opened this screen (or last cleared it). Changes since then are lost."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面を開いたとき(またはクリアしたとき)の内容に戻ります。それ以降の変更は消えます。"
          }
        }
      }
    },
