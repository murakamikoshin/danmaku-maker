    "comment.rules": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it kind. No abuse or links. You can report inappropriate comments."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やさしい言葉で書こう。悪口やリンクは禁止です。不適切なコメントは通報できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请友善发言。禁止辱骂和链接。可以举报不当评论。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請友善發言。禁止辱罵和連結。可以舉報不當評論。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서로 존중해 주세요. 욕설과 링크는 금지예요. 부적절한 댓글은 신고할 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé amable. Sin insultos ni enlaces. Puedes denunciar los comentarios inapropiados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez aimable. Pas d'insultes ni de liens. Vous pouvez signaler les commentaires inappropriés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleib freundlich. Keine Beleidigungen oder Links. Unangemessene Kommentare kannst du melden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja gentil. Sem ofensas ou links. Você pode denunciar comentários inadequados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будьте доброжелательны. Без оскорблений и ссылок. Вы можете пожаловаться на неприемлемые комментарии."
          }
        }
      }
    },
