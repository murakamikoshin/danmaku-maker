    "error.publish.replay-not-cleared": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stage hasn't been cleared yet. Test-play it again and clear it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このステージは、まだクリアできていません。もう一度テストプレイしてクリアしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个关卡还没有通关。请再次试玩并通关。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個關卡還沒有通關。請再次試玩並通關。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스테이지는 아직 클리어하지 않았어요. 다시 테스트 플레이해서 클리어하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este nivel aún no se ha superado. Pruébalo de nuevo y supéralo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce niveau n'a pas encore été réussi. Testez-le à nouveau et terminez-le."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Level wurde noch nicht geschafft. Spiele es erneut im Test und schaffe es."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta fase ainda não foi vencida. Teste-a novamente e passe dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот уровень ещё не пройден. Пройдите его в тестовой игре снова."
          }
        }
      }
    },
    "error.publish.sign-in-required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please sign in first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先登入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 로그인해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez d'abord vous connecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte zuerst anmelden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала войдите в аккаунт."
          }
        }
      }
    },
    "error.publish.too-fast": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please wait a moment before publishing again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けて投稿できません。少し待ってからもう一度どうぞ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍等片刻再发布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請稍等片刻再發布。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 후에 다시 게시해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera un momento antes de volver a publicar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Patientez un instant avant de publier à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte warte einen Moment, bevor du erneut veröffentlichst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde um momento antes de publicar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подождите немного, прежде чем публиковать снова."
          }
        }
      }
    },
    "error.signin.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't sign in. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインできませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录失败,请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入失敗,請重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인할 수 없었어요. 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar sesión. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion impossible. Veuillez réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung fehlgeschlagen. Bitte erneut versuchen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível entrar. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось войти. Повторите попытку."
          }
        }
      }
    },
