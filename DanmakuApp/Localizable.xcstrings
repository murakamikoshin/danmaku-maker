    "delete.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All stages you published, your likes, and your account data will be deleted permanently. To continue, sign in with Apple again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが投稿したステージ、いいね、アカウント情報がすべて削除され、元に戻せません。続けるには、Apple でもう一度サインインしてください。"
          }
        }
      }
    },
    "delete.done.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
