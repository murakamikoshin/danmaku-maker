            "state": "translated",
            "value": "Para publicar, supera el nivel en una prueba (si lo cambias, hay que superarlo de nuevo)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour publier, réussissez le niveau en test (le modifier oblige à le réussir à nouveau)."
