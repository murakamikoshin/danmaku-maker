    "shop.custom.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bullets are shown small, so simple pictures work best. The white dot at the center of your ship (the hit spot) is always shown on top of your image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弾は小さく表示されるので、シンプルな絵がおすすめです。自機の中心の白い点(当たる場所)は、画像の上にそのまま表示されます。"
          }
        }
      }
    },
    "shop.custom.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the boss, bullets and your ship with an image from your photos. Only the look changes. Images stay on your device and are never uploaded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボス・弾・自機を、写真アプリから選んだ画像に変えられます。見た目だけが変わります。画像は端末の中にだけ保存され、送信されません。"
          }
        }
      }
    },
    "shop.custom.pick": {
      "localizations": {
