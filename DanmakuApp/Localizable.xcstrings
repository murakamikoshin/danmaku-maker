    "detail.delete.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your stage. Its rankings, comments and likes are removed too, and this can't be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが投稿したステージです。ランキング・コメント・いいねも一緒に消えて、元に戻せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是你的关卡。它的排名、评论和点赞也会一并移除,且无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是你的關卡。它的排名、評論和點贊也會一併移除,且無法撤銷。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 만든 스테이지예요. 랭킹, 댓글, 좋아요도 함께 삭제되며 되돌릴 수 없어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es tu nivel. También se quitan sus rankings, comentarios y me gusta, y no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est votre niveau. Ses classements, commentaires et « J'aime » sont aussi retirés, et c'est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist dein Level. Ranglisten, Kommentare und Likes werden ebenfalls entfernt. Das lässt sich nicht rückgängig machen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a sua fase. Seus rankings, comentários e curtidas também são removidos, e isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это ваш уровень. Его рейтинги, комментарии и лайки тоже будут удалены, и это нельзя отменить."
          }
        }
      }
    },
