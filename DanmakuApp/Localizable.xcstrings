    "mystage.delete.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will be removed from this device. A posted stage stays online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末から消えます。投稿済みのステージは、世界のステージとして残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从本机删除。已发布的关卡仍保留在线上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將從本機刪除。已釋出的關卡仍保留線上上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 삭제돼요. 게시한 스테이지는 온라인에 그대로 남아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quitará de este dispositivo. Un nivel publicado sigue en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sera retiré de cet appareil. Un niveau publié reste en ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird von diesem Gerät entfernt. Ein veröffentlichtes Level bleibt online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Será removida deste dispositivo. Uma fase publicada continua online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он будет удалён с этого устройства. Опубликованный уровень останется онлайн."
          }
        }
      }
    },
