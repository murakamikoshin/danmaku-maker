    "editor.markers.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dotted diamond appears just before bullets fire. Hiding it makes the stage much harder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弾が出る場所に、出る少し前から点線のひし形が出ます。消すと、ぐっと難しくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "子弹发射前,会出现虚线菱形。隐藏后关卡会难得多。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "子彈發射前,會出現虛線菱形。隱藏後關卡會難得多。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탄이 발사되기 직전에 점선 다이아몬드가 나타나요. 숨기면 스테이지가 훨씬 어려워져요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rombo punteado aparece justo antes de que salgan las balas. Ocultarlo hace el nivel mucho más difícil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un losange en pointillés apparaît juste avant que les projectiles partent. Le masquer rend le niveau bien plus difficile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz bevor Kugeln abgefeuert werden, erscheint eine gestrichelte Raute. Ohne sie wird das Level deutlich schwerer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um losango pontilhado aparece pouco antes de as balas saírem. Escondê-lo deixa a fase muito mais difícil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пунктирный ромб появляется перед самым выстрелом пуль. Без него уровень становится заметно сложнее."
          }
        }
      }
    },
