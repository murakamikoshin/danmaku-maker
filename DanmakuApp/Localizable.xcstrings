    "editor.hint.clear": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To publish, clear the stage in a test play (changing it requires clearing again)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿するには、テストプレイでクリアしてください(内容を変えると、もう一度クリアが必要です)。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
