    "shop.pattern.accel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow at first, then faster and faster, fanned toward you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくり出て、どんどん速くなる自機狙いの扇。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起初很慢,然后越来越快,朝你扇形展开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "起初很慢,然後越來越快,朝你扇形展開。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음엔 느리다가 점점 빨라지며 부채꼴로 다가와요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al principio lentas, luego cada vez más rápidas, en abanico hacia ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lents au début, puis de plus en plus rapides, en éventail vers vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erst langsam, dann immer schneller, fächerförmig auf dich zu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lentas no início, depois cada vez mais rápidas, em leque na sua direção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала медленные, потом всё быстрее, веером в вашу сторону."
          }
        }
      }
    },
    "shop.pattern.beam": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A beam of bullets of different speeds stretching toward you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自機に向けて、速さの違う弾が一直線に伸びる光線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朝你延伸的一束速度各异的子弹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "朝你延伸的一束速度各異的子彈。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "속도가 다른 탄들이 빔처럼 길게 뻗어 와요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rayo de balas de distintas velocidades que se extiende hacia ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un faisceau de projectiles de vitesses différentes qui s'étire vers vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Strahl aus Kugeln unterschiedlicher Geschwindigkeit, der sich auf dich zu streckt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um feixe de balas de velocidades diferentes que se estende até você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Луч из пуль разной скорости, тянущийся к вам."
          }
        }
      }
    },
    "shop.pattern.bounce": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fan toward you that bounces twice off the side walls."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右の壁で2回はね返る自機狙いの扇。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朝你的扇形弹幕,会在两侧墙壁反弹两次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "朝你的扇形彈幕,會在兩側牆壁反彈兩次。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
