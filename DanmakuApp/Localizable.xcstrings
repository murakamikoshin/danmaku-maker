        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Balas que estallan en otras más pequeñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des projectiles qui éclatent en petits projectiles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
