    "shop.reward.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post stages to unlock new looks for free. Posts are counted from the server's records."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステージを投稿すると、新しい見た目が無料で解放されます。投稿数はサーバーの記録で数えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布关卡即可免费解锁新外观。发布数量以服务器记录为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釋出關卡即可免費解鎖新外觀。釋出數量以伺服器記錄為準。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스테이지를 게시하면 새 외형을 무료로 해금할 수 있어요. 게시 수는 서버 기록으로 집계돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Publica niveles para desbloquear aspectos nuevos gratis. Las publicaciones se cuentan según los registros del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Publiez des niveaux pour débloquer gratuitement de nouvelles apparences. Les publications sont comptées d'après les enregistrements du serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Veröffentliche Level, um neue Looks kostenlos freizuschalten. Veröffentlichungen werden anhand der Serverdaten gezählt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Publique fases para desbloquear novos visuais de graça. As publicações são contadas pelos registros do servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Публикуйте уровни, чтобы бесплатно открывать новые стили. Публикации считаются по данным сервера."
          }
        }
      }
    },
