    "ranking.revived": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears that used a revive aren't counted in rankings or clear stats."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復活を使ったクリアは、ランキングとクリア数には数えられません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用了复活的通关不计入排行榜和通关统计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用了復活的通關不計入排行榜和通關統計。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부활을 사용한 클리어는 랭킹과 클리어 통계에 반영되지 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partidas superadas con una reaparición no cuentan en los rankings ni en las estadísticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réussites avec une résurrection ne comptent pas dans les classements ni dans les statistiques."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchgänge mit Wiederbelebung zählen nicht für Ranglisten und Statistiken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitórias com renascimento não contam nos rankings nem nas estatísticas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прохождения с воскрешением не учитываются в рейтингах и статистике."
          }
        }
      }
    },
    "ranking.standard.only": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every run is ranked, using the shot the creator chose for the stage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランキングには、そのステージで作者が決めた撃ち方で遊んだ記録が載ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有成绩都会入榜,并使用作者为该关卡指定的射击方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有成績都會入榜,並使用作者為該關卡指定的射擊方式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기록이 랭킹에 올라가며, 제작자가 스테이지에 지정한 샷이 사용돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las partidas puntúan, con el disparo que eligió el creador para el nivel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque partie est classée, avec le tir choisi par le créateur pour le niveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Durchgang wird gewertet, mit dem Schuss, den der Ersteller für das Level gewählt hat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda partida entra no ranking, usando o tiro que o criador escolheu para a fase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое прохождение попадает в рейтинг с выстрелом, выбранным автором уровня."
          }
        }
      }
    },
