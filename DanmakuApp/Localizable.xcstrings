    "detail.block.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their stages will be hidden from lists. You can unblock them in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックした作者のステージは一覧に表示されなくなります。設定からいつでも解除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该作者的关卡将不再出现在列表中。你可以在设置中解除屏蔽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該作者的關卡將不再出現在列表中。你可以在設定中解除遮蔽。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작성자의 스테이지가 목록에서 숨겨져요. 설정에서 차단을 해제할 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus niveles se ocultarán de las listas. Puedes desbloquearlo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses niveaux seront masqués des listes. Vous pouvez le débloquer dans les Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Level werden in den Listen ausgeblendet. Du kannst ihn in den Einstellungen wieder freigeben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fases dele ficarão ocultas das listas. Você pode desbloqueá-lo em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его уровни будут скрыты из списков. Разблокировать можно в настройках."
          }
        }
      }
    },
