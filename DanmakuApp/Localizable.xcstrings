    "editor.unlimited.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No time limit. You clear it by defeating the boss. Elapsed time is shown while playing (10 minutes max)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限時間はなく、ボスを倒したときがクリアです。遊ぶ画面には、経過時間が出ます(最長10分)。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不限时。击败 BOSS 即通关。游玩时会显示经过的时间(最长10分钟)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不限時。擊敗 BOSS 即通關。遊玩時會顯示經過的時間(最長10分鐘)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간 제한이 없어요. 보스를 쓰러뜨리면 클리어예요. 플레이 중 경과 시간이 표시돼요 (최대 10분)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin límite de tiempo. Lo superas al derrotar al jefe. Mientras juegas se muestra el tiempo transcurrido (máx. 10 minutos)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de limite de temps. Vous réussissez en battant le boss. Le temps écoulé s'affiche pendant la partie (10 minutes max)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zeitlimit. Du schaffst es, indem du den Boss besiegst. Während des Spiels wird die verstrichene Zeit angezeigt (max. 10 Minuten)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem limite de tempo. Você vence derrotando o chefe. O tempo decorrido aparece durante o jogo (máx. 10 minutos)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без лимита времени. Вы проходите уровень, победив босса. Во время игры показывается прошедшее время (максимум 10 минут)."
          }
        }
      }
    },
