            "value": "Couldn't load that image"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を読み込めませんでした"
          }
        }
      }
    },
    "shop.custom.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bullets are shown small, so simple pictures work best. The white dot at the center of your ship (the hit spot) is always shown on top of your image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弾は小さく表示されるので、シンプルな絵がおすすめです。自機の中心の白い点(当たる場所)は、画像の上にそのまま表示されます。"
          }
        }
      }
    },
    "shop.custom.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the boss, bullets and your ship with an image from your photos. Only the look changes. Choose per stage whether to use them; they only apply on this device (removed when you post). Images stay on your device and are never uploaded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボス・弾・自機を、写真アプリから選んだ画像に変えられます。見た目だけが変わります。作るステージごとに使うかを選べて、この端末で遊ぶときだけ使えます(投稿すると外れます)。画像は端末の中にだけ保存され、送信されません。"
          }
        }
      }
    },
    "shop.custom.pick": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を選ぶ"
          }
        }
      }
    },
    "shop.custom.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own images"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
