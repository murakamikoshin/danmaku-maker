    "editor.shot.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone who plays this stage uses this shot (test plays too). Only shots you own can be picked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このステージを遊ぶ全員が、この撃ち方になります(テストプレイも同じ)。買った撃ち方だけ選べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有游玩此关卡的人(包括试玩)都会使用这种射击方式。只能选择你已拥有的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有遊玩此關卡的人(包括試玩)都會使用這種射擊方式。只能選擇你已擁有的。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스테이지를 플레이하는 모두가 이 샷을 사용해요 (테스트 플레이 포함). 보유한 샷만 고를 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los que jueguen este nivel usan este disparo (también en las pruebas). Solo se pueden elegir los disparos que tengas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous ceux qui jouent ce niveau utilisent ce tir (tests compris). Seuls les tirs que vous possédez peuvent être choisis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle, die dieses Level spielen, nutzen diesen Schuss (auch im Testspiel). Nur Schüsse im Besitz sind wählbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos que jogarem esta fase usam este tiro (inclusive nos testes). Só dá para escolher tiros que você possui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все, кто играет в этот уровень, используют этот выстрел (в тестовой игре тоже). Выбрать можно только имеющиеся виды стрельбы."
          }
        }
      }
    },
