    "editor.boss.note": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボス戦では発射台はボスにくっつきます。HPが減るごとに「第1〜第3段階」に切り替わり、切り替わりで画面の弾が消えます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emitters attach to the boss. As its HP drops it moves through phases 1–3, and each switch clears the screen."
          }
        }
      }
    },
