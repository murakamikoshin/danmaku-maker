    "editor.revert.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go back to how it was?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集前の状態に戻しますか?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复到之前的状态?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復到之前的狀態?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 상태로 되돌릴까요?"
