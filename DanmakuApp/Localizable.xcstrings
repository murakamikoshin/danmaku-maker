    "settings.stagelook.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off to play with the standard look instead of the creator's (if it is hard to see)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、作った人が選んだ見た目を使わず、標準の見た目で遊べます(見づらいときに)。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后将使用标准外观,而不是作者设定的外观(看不清时很有用)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後將使用標準外觀,而不是作者設定的外觀(看不清時很有用)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 제작자의 외형 대신 기본 외형으로 플레이해요 (보기 어려울 때 유용해요)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalo para jugar con el aspecto estándar en lugar del del creador (si cuesta ver)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez pour jouer avec l'apparence standard plutôt que celle du créateur (si c'est difficile à lire)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausschalten, um mit dem Standard-Look statt dem des Erstellers zu spielen (wenn er schwer zu erkennen ist)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative para jogar com o visual padrão em vez do do criador (se estiver difícil de ver)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключите, чтобы играть со стандартным видом вместо авторского (если плохо видно)."
          }
        }
      }
    },
