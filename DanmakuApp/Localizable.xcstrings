    "shop.hero.sub": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it yours. Make it wild."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "きせかえて、もっとワクワクしよう"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打造你的风格,尽情狂野。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打造你的風格,盡情狂野。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만의 스타일로, 마음껏 화려하게."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazlo tuyo. Hazlo salvaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites-le à votre image. Faites-le sauvage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach es zu deinem. Mach es wild."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe com a sua cara. Deixe selvagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте по-своему. Сделайте дико."
          }
        }
      }
    },
    "shop.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buy looks, bullet patterns and shot styles for your stages. All shot styles deal the same damage per second; only the feel differs. Everything is a one-time purchase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステージ作りで使える、見た目・弾幕・撃ち方などを買えます。撃ち方は1秒あたりの威力が同じで、撃ち味だけが違います。どれも買い切りです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买外观、弹幕图案和射击方式来制作关卡。所有射击方式的每秒伤害相同,只是手感不同。全部为一次性购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買外觀、彈幕圖案和射擊方式來製作關卡。所有射擊方式的每秒傷害相同,只是手感不同。全部為一次性購買。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스테이지용 외형, 탄 패턴, 샷 스타일을 구매하세요. 모든 샷 스타일은 초당 데미지가 같고 느낌만 달라요. 모두 한 번만 결제하면 돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra aspectos, patrones de balas y estilos de disparo para tus niveles. Todos los estilos de disparo causan el mismo daño por segundo; solo cambia la sensación. Todo es una compra única."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achetez des apparences, des motifs de projectiles et des styles de tir pour vos niveaux. Tous les styles de tir infligent les mêmes dégâts par seconde ; seul le ressenti change. Tout est un achat unique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaufe Looks, Kugelmuster und Schussstile für deine Level. Alle Schussstile richten pro Sekunde gleich viel Schaden an; nur das Gefühl ist anders. Alles sind Einmalkäufe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compre visuais, padrões de bala e estilos de tiro para suas fases. Todos os estilos de tiro causam o mesmo dano por segundo; só muda a sensação. Tudo é compra única."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупайте стили, узоры пуль и виды стрельбы для своих уровней. Все виды стрельбы наносят одинаковый урон в секунду; отличается только ощущение. Все покупки разовые."
          }
        }
      }
    },
