    "editor.bgm.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to preview. Players hear the song you pick here (unless they turn music off)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押すと試聴できます。遊ぶ人には、ここで選んだ曲が流れます(音を消している人には流れません)。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按试听。玩家会听到你在这里选的曲子(除非关闭了音乐)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按試聽。玩家會聽到你在這裡選的曲子(除非關閉了音樂)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하면 미리 들을 수 있어요. 플레이어에게는 여기서 고른 곡이 들려요 (음악을 끈 경우 제외)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para escuchar. Los jugadores oirán la canción que elijas aquí (salvo que desactiven la música)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour écouter. Les joueurs entendront le morceau choisi ici (sauf s'ils coupent la musique)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen zum Anhören. Spieler hören den Song, den du hier wählst (außer sie schalten die Musik aus)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para ouvir. Os jogadores ouvirão a música que você escolher aqui (a menos que desativem a música)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы прослушать. Игроки услышат выбранную здесь песню (если не отключат музыку)."
          }
        }
      }
    },
