    "editor.warning.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen flashes red and a siren sounds. For a big boss entrance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面が赤く点滅して、サイレンが鳴ります。大ボスの登場に。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕会闪红光并响起警报。适合大BOSS登场。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕會閃紅光並響起警報。適合大BOSS登場。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 붉게 깜박이고 사이렌이 울려요. 대형 보스의 등장 연출용이에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla parpadea en rojo y suena una sirena. Para la gran entrada de un jefe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écran clignote en rouge et une sirène retentit. Pour l'entrée d'un gros boss."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm blinkt rot und eine Sirene ertönt. Für einen großen Boss-Auftritt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela pisca em vermelho e uma sirene toca. Para a grande entrada de um chefe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран мигает красным, звучит сирена. Для эффектного появления большого босса."
          }
        }
      }
    },
