    "editor.hint.unlisted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stage you haven't cleared yet can be shared by link only: it stays out of the public list and only friends with the link can play. Clear it to publish it to everyone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだクリアしていないステージは、一覧には出さず、URLを知っている友達だけが遊べる形で送れます。クリアすると、みんなに公開できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未通关的关卡只能通过链接分享:它不会出现在公开列表中,只有拿到链接的朋友才能游玩。通关后即可向所有人发布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未通關的關卡只能透過連結分享:它不會出現在公開列表中,只有拿到連結的朋友才能遊玩。通關後即可向所有人釋出。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 클리어하지 않은 스테이지는 링크로만 공유할 수 있어요. 공개 목록에는 나오지 않고, 링크를 아는 친구만 플레이할 수 있어요. 클리어하면 모두에게 게시할 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nivel que aún no has superado solo se puede compartir por enlace: no aparece en la lista pública y solo lo juegan los amigos que tengan el enlace. Supéralo para publicarlo para todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un niveau que vous n'avez pas encore réussi ne peut être partagé que par lien : il reste hors de la liste publique et seuls les amis qui ont le lien peuvent y jouer. Réussissez-le pour le publier pour tous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Level, das du noch nicht geschafft hast, kann nur per Link geteilt werden: Es bleibt aus der öffentlichen Liste draußen, und nur Freunde mit dem Link können es spielen. Schaffe es, um es für alle zu veröffentlichen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma fase que você ainda não venceu só pode ser compartilhada por link: ela fica fora da lista pública e só os amigos com o link podem jogá-la. Vença-a para publicá-la para todos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Непройденный уровень можно отправить только по ссылке: он не попадает в общий список, и играть в него могут только друзья со ссылкой. Пройдите его, чтобы опубликовать для всех."
          }
        }
      }
    },
