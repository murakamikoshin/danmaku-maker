    "shop.creator.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks you buy here are used in the stages you create. Players see the creator's look in that stage, even without buying it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで買った見た目は、あなたが作るステージで使えます。遊ぶ人は、買っていなくても、そのステージでは作者の見た目で遊べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在这里购买的外观会用于你制作的关卡。即使没有购买,玩家在该关卡中也能看到作者设定的外观。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在這裡購買的外觀會用於你製作的關卡。即使沒有購買,玩家在該關卡中也能看到作者設定的外觀。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 구매한 외형은 내가 만드는 스테이지에 사용돼요. 구매하지 않아도 플레이어는 그 스테이지에서 제작자의 외형을 볼 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los aspectos que compres aquí se usan en los niveles que crees. Los jugadores ven el aspecto del creador en ese nivel, aunque no lo hayan comprado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apparences achetées ici sont utilisées dans les niveaux que vous créez. Les joueurs voient l'apparence du créateur dans ce niveau, même sans l'avoir achetée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks, die du hier kaufst, werden in deinen erstellten Leveln verwendet. Spieler sehen den Look des Erstellers in diesem Level, auch ohne ihn zu kaufen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os visuais que você compra aqui são usados nas fases que você cria. Os jogadores veem o visual do criador nessa fase, mesmo sem comprá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Купленные здесь стили используются в созданных вами уровнях. Игроки видят авторский вид в этом уровне, даже если не покупали его."
          }
        }
      }
    },
