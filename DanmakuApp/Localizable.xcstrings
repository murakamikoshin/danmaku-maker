    "editor.damage.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The boss has infinite HP. Survive until time is up and your total damage is recorded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボスのHPは無限です。制限時間まで生き残ると、与えたダメージの合計が記録されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BOSS 的 HP 无限。撑到时间结束,将记录你造成的总伤害。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "BOSS 的 HP 無限。撐到時間結束,將記錄你造成的總傷害。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보스 HP는 무한이에요. 시간이 끝날 때까지 버티면 총 데미지가 기록돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El jefe tiene HP infinito. Sobrevive hasta que se acabe el tiempo y se registrará tu daño total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le boss a des PV infinis. Survivez jusqu'à la fin du temps et vos dégâts totaux seront enregistrés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Boss hat unendlich HP. Überlebe, bis die Zeit abläuft, dann wird dein Gesamtschaden gespeichert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chefe tem HP infinito. Sobreviva até o tempo acabar e seu dano total será registrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У босса бесконечное HP. Продержитесь до конца времени, и ваш суммарный урон будет записан."
          }
        }
      }
    },
