    "shot.spread.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three shots in a narrow fan. All three hit when you line up with the boss."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3方向に少し広がる。ボスの正面なら3発とも当たる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三发子弹呈窄扇形。对准 BOSS 时三发全中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三發子彈呈窄扇形。對準 BOSS 時三發全中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좁은 부채꼴로 세 발. 보스와 일직선일 때 세 발 모두 맞아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres disparos en un abanico estrecho. Los tres aciertan si te alineas con el jefe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois tirs en éventail étroit. Les trois touchent quand vous êtes aligné avec le boss."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Schüsse in einem schmalen Fächer. Alle drei treffen, wenn du auf den Boss ausgerichtet bist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três tiros em um leque estreito. Os três acertam quando você se alinha com o chefe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три выстрела узким веером. Все три попадают, когда вы на одной линии с боссом."
          }
        }
      }
    },
