    "editor.revert.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Returns to how the stage was when you opened this screen (or last cleared it). Changes since then are lost."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面を開いたとき(またはクリアしたとき)の内容に戻ります。それ以降の変更は消えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将恢复到你打开此页面时(或上次通关时)的关卡状态。之后的修改将丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將恢復到你開啟此頁面時(或上次通關時)的關卡狀態。之後的修改將丟失。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면을 열었을 때(또는 마지막으로 클리어했을 때)의 스테이지로 되돌려요. 그 이후의 변경은 사라져요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a cómo estaba el nivel al abrir esta pantalla (o la última vez que lo superaste). Se pierden los cambios posteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revient à l'état du niveau à l'ouverture de cet écran (ou à votre dernière réussite). Les modifications depuis sont perdues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt das Level auf den Stand beim Öffnen dieses Bildschirms (oder beim letzten Schaffen) zurück. Spätere Änderungen gehen verloren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta ao estado da fase quando você abriu esta tela (ou quando a venceu pela última vez). As alterações feitas desde então serão perdidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает уровень к состоянию на момент открытия этого экрана (или последнего прохождения). Изменения после этого будут потеряны."
          }
        }
      }
    },
