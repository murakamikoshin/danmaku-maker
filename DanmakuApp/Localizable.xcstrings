          "stringUnit": {
            "state": "translated",
            "value": "Show your own look to everyone who plays this stage. Pick from what you have bought in the shop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弾・背景・自機の見た目を、このステージを遊ぶ全員に見せられます。ショップで買ったものから選べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让所有游玩此关卡的人看到你的外观。可从你在商店购买的内容中选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓所有遊玩此關卡的人看到你的外觀。可從你在商店購買的內容中選擇。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스테이지를 플레이하는 모든 사람에게 내 외형을 보여 줘요. 상점에서 구매한 것 중에서 고를 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tu propio aspecto a todos los que jueguen este nivel. Elige entre lo que compraste en la tienda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montrez votre propre apparence à tous ceux qui jouent ce niveau. Choisissez parmi ce que vous avez acheté dans la boutique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige allen, die dieses Level spielen, dein eigenes Aussehen. Wähle aus dem, was du im Shop gekauft hast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre seu visual para todos que jogarem esta fase. Escolha entre o que você comprou na loja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажите свой внешний вид всем, кто играет в этот уровень. Выбирайте из купленного в магазине."
          }
        }
      }
    },
