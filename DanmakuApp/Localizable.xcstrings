    "handle.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your ranking name is picked from preset words. The 4-digit number is assigned automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランキングの名前は、決まった言葉から選びます。後ろの4桁の数字は、自動で決まります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排行榜昵称由预设词语组合而成。4位数字会自动分配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排行榜暱稱由預設詞語組合而成。4位數字會自動分配。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "랭킹 이름은 미리 정해진 단어로 만들어져요. 4자리 숫자는 자동으로 붙어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre del ranking se elige entre palabras predefinidas. El número de 4 dígitos se asigna automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre nom de classement est choisi parmi des mots prédéfinis. Le nombre à 4 chiffres est attribué automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Ranglistenname wird aus vorgegebenen Wörtern gewählt. Die 4-stellige Zahl wird automatisch vergeben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu nome no ranking é escolhido entre palavras predefinidas. O número de 4 dígitos é atribuído automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя в рейтинге выбирается из готовых слов. Четырёхзначное число присваивается автоматически."
          }
        }
      }
    },
