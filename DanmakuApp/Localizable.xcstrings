    "shop.pattern.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New patterns for building stages. Anyone can play stages that use them, even without buying."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステージ作りで使える新しい弾幕です。使ったステージは、買っていない人も遊べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于制作关卡的新图案。即使没有购买,任何人都可以游玩使用了这些图案的关卡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於製作關卡的新圖案。即使沒有購買,任何人都可以遊玩使用了這些圖案的關卡。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스테이지 제작용 새 패턴이에요. 구매하지 않아도 누구나 이 패턴이 쓰인 스테이지를 플레이할 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuevos patrones para crear niveles. Cualquiera puede jugar niveles que los usen, aunque no los haya comprado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De nouveaux motifs pour créer des niveaux. Tout le monde peut jouer les niveaux qui les utilisent, même sans les acheter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Muster zum Bauen von Leveln. Level mit diesen Mustern kann jeder spielen, auch ohne Kauf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novos padrões para criar fases. Qualquer pessoa pode jogar fases que os usam, mesmo sem comprar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые узоры для создания уровней. Уровни с ними может проходить любой, даже без покупки."
