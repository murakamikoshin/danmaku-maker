    "editor.boss.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emitters attach to the boss. As its HP drops it moves through phases 1–3, and each switch clears the screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボス戦では発射台はボスにくっつきます。HPが減るごとに「第1〜第3段階」に切り替わり、切り替わりで画面の弾が消えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发射器附着在 BOSS 身上。HP 减少时会进入第1~3阶段,每次切换都会清屏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發射器附著在 BOSS 身上。HP 減少時會進入第1~3階段,每次切換都會清屏。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발사기는 보스에 붙어요. HP가 줄어들면 1~3페이즈로 진행되며, 전환될 때마다 화면의 탄이 모두 사라져요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los emisores se fijan al jefe. Al bajar su HP pasa por las fases 1–3, y cada cambio limpia la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les émetteurs sont attachés au boss. Quand ses PV baissent, il passe par les phases 1 à 3, et chaque changement efface l'écran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Emitter sind am Boss befestigt. Sinkt seine HP, durchläuft er die Phasen 1–3, und jeder Wechsel räumt den Bildschirm."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os emissores ficam presos ao chefe. Conforme o HP cai, ele passa pelas fases 1–3, e cada troca limpa a tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Излучатели крепятся к боссу. По мере снижения HP он проходит фазы 1–3, и при каждой смене экран очищается."
          }
        }
      }
    },
