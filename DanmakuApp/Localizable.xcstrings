    "shop.pattern.stopgo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bullets that stop dead, then dash at you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進んでぴたっと止まり、少しして自機めがけて飛び出す弾。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "子弹会骤然停住,然后向你冲来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "子彈會驟然停住,然後向你衝來。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "딱 멈췄다가 돌진해 오는 탄."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Balas que se detienen en seco y luego se lanzan hacia ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des projectiles qui s'arrêtent net, puis foncent sur vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kugeln, die abrupt stoppen und dann auf dich zurasen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Balas que param de repente e depois avançam em você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пули, которые резко останавливаются, а затем бросаются на вас."
          }
        }
      }
    },
    "shop.pattern.split": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bullets that burst into small ones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
