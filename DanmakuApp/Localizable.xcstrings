    "share.author": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I made a bullet-hell stage: “%@”. Can you clear it? #DanmakuMaker %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の弾幕を作った！クリアできる？ #弾幕メーカー %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我做了一个弹幕关卡:「%@」。你能通关吗?#DanmakuMaker %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我做了一個彈幕關卡:「%@」。你能通關嗎?#DanmakuMaker %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탄막 스테이지를 만들었어요: “%@”. 클리어할 수 있나요? #DanmakuMaker %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creé un nivel de bullet hell: «%@». ¿Puedes superarlo? #DanmakuMaker %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai créé un niveau de bullet hell : « %@ ». Saurez-vous le réussir ? #DanmakuMaker %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe ein Bullet-Hell-Level gebaut: „%@“. Schaffst du es? #DanmakuMaker %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiz uma fase de bullet hell: “%@”. Você consegue vencer? #DanmakuMaker %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я сделал уровень в стиле bullet hell: «%@». Сможете пройти? #DanmakuMaker %@"
          }
        }
      }
    },
