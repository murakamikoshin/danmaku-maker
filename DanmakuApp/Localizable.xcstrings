    "signin.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in is needed to publish, like, and report. Playing doesn't need it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿・いいね・通報にはサインインが必要です。遊ぶだけならサインイン不要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布、点赞和举报需要登录。游玩不需要登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釋出、點贊和舉報需要登入。遊玩不需要登入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시, 좋아요, 신고에는 로그인이 필요해요. 플레이에는 필요 없어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace falta iniciar sesión para publicar, dar me gusta y denunciar. Para jugar no hace falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion est nécessaire pour publier, aimer et signaler. Pas pour jouer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Veröffentlichen, Liken und Melden musst du angemeldet sein. Zum Spielen nicht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso entrar para publicar, curtir e denunciar. Para jogar, não."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход нужен для публикации, лайков и жалоб. Для игры он не нужен."
          }
        }
      }
    },
