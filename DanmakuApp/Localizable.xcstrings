    "publish.terms.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To publish, you need to agree to the Terms of Use and Privacy Policy. Published stages can be played by anyone. Inappropriate content may be removed and accounts suspended."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿するには、利用規約とプライバシーポリシーへの同意が必要です。投稿したステージは誰でも遊べるようになります。不適切な内容は削除し、アカウントを停止することがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布前需要同意《使用条款》和《隐私政策》。已发布的关卡所有人都可以游玩。不当内容可能被删除,账号可能被封停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釋出前需要同意《使用條款》和《隱私政策》。已釋出的關卡所有人都可以遊玩。不當內容可能被刪除,賬號可能被封停。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시하려면 이용약관과 개인정보 처리방침에 동의해야 해요. 게시한 스테이지는 누구나 플레이할 수 있어요. 부적절한 콘텐츠는 삭제되고 계정이 정지될 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para publicar, debes aceptar los Términos de uso y la Política de privacidad. Cualquiera puede jugar los niveles publicados. El contenido inapropiado puede eliminarse y las cuentas suspenderse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour publier, vous devez accepter les Conditions d'utilisation et la Politique de confidentialité. Les niveaux publiés peuvent être joués par tous. Les contenus inappropriés peuvent être supprimés et les comptes suspendus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Veröffentlichen musst du den Nutzungsbedingungen und der Datenschutzerklärung zustimmen. Veröffentlichte Level kann jeder spielen. Unangemessene Inhalte können entfernt und Konten gesperrt werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para publicar, você precisa concordar com os Termos de Uso e a Política de Privacidade. As fases publicadas podem ser jogadas por qualquer pessoa. Conteúdo inadequado pode ser removido e contas podem ser suspensas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы опубликовать, нужно принять Условия использования и Политику конфиденциальности. Опубликованные уровни может проходить любой. Неприемлемый контент может быть удалён, а аккаунты заблокированы."
          }
        }
      }
    },
