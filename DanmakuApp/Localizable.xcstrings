    "settings.effects.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows red flashes and explosions. Turn off if flashing bothers you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤い点滅や爆発の演出を出します。点滅が苦手なときは、オフにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会显示红色闪光和爆炸。如果闪光让你不适,请关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會顯示紅色閃光和爆炸。如果閃光讓你不適,請關閉。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "붉은 번쩍임과 폭발이 표시돼요. 깜박임이 불편하면 꺼 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra destellos rojos y explosiones. Desactívalo si los destellos te molestan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche des flashs rouges et des explosions. Désactivez si les flashs vous gênent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt rote Blitze und Explosionen. Schalte es aus, wenn dich das Blitzen stört."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra flashes vermelhos e explosões. Desative se os flashes incomodarem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает красные вспышки и взрывы. Отключите, если вспышки мешают."
          }
        }
      }
    },
