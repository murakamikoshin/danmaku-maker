    "app.tagline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build it. Share it. Dodge the world."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作って、投稿して、世界と遊ぼう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创造它,分享它,躲过全世界。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "創造它,分享它,躲過全世界。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만들고, 공유하고, 세계의 탄막을 피하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Créalo. Compártelo. Esquiva al mundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez-le. Partagez-le. Esquivez le monde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bauen. Teilen. Der Welt ausweichen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie. Compartilhe. Desvie do mundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавай. Делись. Уворачивайся от всего мира."
          }
        }
      }
    },
