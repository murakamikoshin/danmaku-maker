    "shop.homing.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use bullets that curve toward your ship when building stages. They only home in for 2.5 seconds after firing. Works in survive, boss and damage stages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自機を追いかけて曲がる弾を、ステージ作りで使えるようになります。曲がるのは出てから2.5秒だけ。ボス戦・ダメージ勝負・生き残りのどれでも使えます。"
          }
        }
      }
    },
    "shop.homing.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homing bullets"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追尾弾"
          }
        }
      }
    },
    "shop.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buy new looks for bullets, backgrounds and your ship, plus new shot styles. All shot styles deal the same damage per second; only the feel differs. Everything is a one-time purchase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弾の色・背景・自機の見た目と、自機の撃ち方を買えます。撃ち方は1秒あたりの威力が同じで、撃ち味だけが違います。どれも買い切りです。"
          }
        }
      }
    },
    "shop.off": {
