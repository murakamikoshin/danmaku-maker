    "publish.unlisted.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It won't appear in the public list. Only people with the link can play."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一覧には載りません。URLを知っている人だけが遊べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它不会出现在公开列表中。只有拿到链接的人才能游玩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它不會出現在公開列表中。只有拿到連結的人才能遊玩。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 목록에는 나오지 않아요. 링크를 아는 사람만 플레이할 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No aparecerá en la lista pública. Solo pueden jugarlo quienes tengan el enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'apparaîtra pas dans la liste publique. Seules les personnes ayant le lien peuvent y jouer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es erscheint nicht in der öffentlichen Liste. Nur Personen mit dem Link können es spielen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela não aparecerá na lista pública. Só quem tem o link pode jogar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он не появится в общем списке. Играть смогут только те, у кого есть ссылка."
