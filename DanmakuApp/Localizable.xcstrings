    "editor.simple.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just the basics: name, time, bullet type and color are enough to play."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずは基本だけ。名前・時間・弾の種類と色を決めれば、遊べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需基本设置:名称、时间、子弹类型和颜色就能开玩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只需基本設定:名稱、時間、子彈型別和顏色就能開玩。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본만 설정해요: 이름, 시간, 탄 종류, 색상만 있으면 바로 플레이할 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lo básico: con el nombre, el tiempo, el tipo de bala y el color basta para jugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'essentiel : le nom, la durée, le type de projectile et la couleur suffisent pour jouer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur das Wichtigste: Name, Zeit, Kugeltyp und Farbe reichen zum Spielen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o básico: nome, tempo, tipo de bala e cor já bastam para jogar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только основное: названия, времени, типа пуль и цвета достаточно, чтобы играть."
          }
        }
      }
    },
