    "home.mine.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stages you make are saved automatically. Play and edit them anytime, even without posting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作ったステージは、自動で保存されます。投稿しなくても、いつでも遊べて、直せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你制作的关卡会自动保存。即使不发布,也可以随时游玩和编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你製作的關卡會自動儲存。即使不釋出,也可以隨時遊玩和編輯。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만든 스테이지는 자동으로 저장돼요. 게시하지 않아도 언제든 플레이하고 편집할 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los niveles que creas se guardan automáticamente. Juégalos y edítalos cuando quieras, aunque no los publiques."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les niveaux que vous créez sont enregistrés automatiquement. Jouez-les et modifiez-les quand vous voulez, même sans les publier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Level, die du erstellst, werden automatisch gespeichert. Spiele und bearbeite sie jederzeit, auch ohne sie zu veröffentlichen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fases que você cria são salvas automaticamente. Jogue e edite quando quiser, mesmo sem publicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Созданные вами уровни сохраняются автоматически. Играйте и редактируйте их в любое время, даже без публикации."
          }
        }
      }
    },
