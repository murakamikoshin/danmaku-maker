    "shop.hero.sub": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it yours. Make it wild."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "きせかえて、もっとワクワクしよう"
          }
        }
      }
    },
    "shop.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buy looks, bullet patterns and shot styles for your stages. All shot styles deal the same damage per second; only the feel differs. Everything is a one-time purchase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステージ作りで使える、見た目・弾幕・撃ち方などを買えます。撃ち方は1秒あたりの威力が同じで、撃ち味だけが違います。どれも買い切りです。"
          }
        }
      }
    },
    "shop.off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d%% OFF"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d%%OFF"
          }
        }
      }
    },
    "shop.owned": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Owned"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入済み"
          }
        }
      }
    },
    "shop.pattern.accel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow at first, then faster and faster, fanned toward you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくり出て、どんどん速くなる自機狙いの扇。"
          }
        }
      }
    },
    "shop.pattern.beam": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A beam of bullets of different speeds stretching toward you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自機に向けて、速さの違う弾が一直線に伸びる光線。"
          }
        }
      }
    },
    "shop.pattern.bounce": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fan toward you that bounces twice off the side walls."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右の壁で2回はね返る自機狙いの扇。"
          }
        }
      }
    },
    "shop.pattern.cross": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lines of bullets stretching in four directions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下左右に、弾が列になって伸びる十字。"
          }
        }
      }
    },
    "shop.pattern.flower": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A ring shaped like a five-petal flower. It can slowly spin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5枚の花びらの形に広がる輪。ゆっくり回せます。"
          }
        }
      }
    },
    "shop.pattern.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New patterns for building stages. Anyone can play stages that use them, even without buying."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステージ作りで使える新しい弾幕です。使ったステージは、買っていない人も遊べます。"
          }
        }
      }
    },
    "shop.pattern.heart": {
