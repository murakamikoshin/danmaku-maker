    "mystage.delete.world.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stage is published. Deleting it from the world also removes its rankings, comments and likes, and can't be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このステージは投稿済みです。世界から消すと、ランキング・コメント・いいねも一緒に消えて、元に戻せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该关卡已发布。从世界中删除也会移除它的排名、评论和点赞,且无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該關卡已釋出。從世界中刪除也會移除它的排名、評論和點贊,且無法撤銷。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스테이지는 게시되어 있어요. 월드에서 삭제하면 랭킹, 댓글, 좋아요도 함께 삭제되며 되돌릴 수 없어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este nivel está publicado. Eliminarlo del mundo también quita sus rankings, comentarios y me gusta, y no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce niveau est publié. Le supprimer du monde retire aussi ses classements, commentaires et « J'aime », et c'est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Level ist veröffentlicht. Beim Löschen aus der Welt werden auch Ranglisten, Kommentare und Likes entfernt. Das lässt sich nicht rückgängig machen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta fase está publicada. Excluí-la do mundo também remove seus rankings, comentários e curtidas, e não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот уровень опубликован. Удаление из мира также удалит его рейтинги, комментарии и лайки, и это нельзя отменить."
          }
        }
      }
    },
    "mystage.delete.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't delete. Check your connection and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除できませんでした。通信を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法删除。请检查网络后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法刪除。請檢查網路後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제할 수 없어요. 네트워크 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo eliminar. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppression impossible. Vérifiez votre connexion et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen nicht möglich. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível excluir. Verifique sua conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось удалить. Проверьте соединение и повторите попытку."
          }
        }
      }
    },
