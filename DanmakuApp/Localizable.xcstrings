    "shot.heavy.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One thick shot with 4x damage. A miss deals nothing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "太い1発でダメージ4倍。外すとダメージが出ない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一发粗大的子弹,伤害为4倍。打空则没有伤害。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一發粗大的子彈,傷害為4倍。打空則沒有傷害。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "굵은 탄 한 발, 데미지 4배. 빗나가면 데미지가 없어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un disparo grueso con 4 veces de daño. Si falla, no causa nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gros tir avec 4 fois plus de dégâts. S'il rate, il n'inflige rien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein dicker Schuss mit 4-fachem Schaden. Ein Fehlschuss richtet nichts an."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um tiro grosso com 4x de dano. Se errar, não causa nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один толстый выстрел с 4-кратным уроном. Промах не наносит урона."
          }
        }
      }
    },
