    "editor.enemy.size.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bigger bosses are easier to hit; smaller ones are harder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きいほど弾が当たりやすく、小さいほど難しくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BOSS 越大越容易命中,越小越难。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "BOSS 越大越容易命中,越小越難。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보스가 클수록 맞히기 쉽고, 작을수록 어려워요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los jefes grandes son más fáciles de acertar; los pequeños, más difíciles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les gros boss sont plus faciles à toucher ; les petits, plus difficiles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größere Bosse sind leichter zu treffen, kleinere schwerer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chefes maiores são mais fáceis de acertar; menores, mais difíceis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В больших боссов легче попасть; в маленьких труднее."
