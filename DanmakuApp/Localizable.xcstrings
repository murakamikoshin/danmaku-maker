    "editor.custom.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only used when you play on this device. When you post, the images are removed (others see the stage look above)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末で遊ぶときだけ使えます。投稿すると、画像は外れます(他の人には、上の見た目だけが見えます)。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在本机游玩时使用。发布时图片会被移除(其他玩家看到的是上面设定的关卡外观)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在本機遊玩時使用。釋出時圖片會被移除(其他玩家看到的是上面設定的關卡外觀)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 플레이할 때만 사용돼요. 게시하면 이미지는 제거돼요 (다른 사람에게는 위에서 정한 스테이지 외형이 보여요)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se usan cuando juegas en este dispositivo. Al publicar, las imágenes se quitan (los demás ven el aspecto del nivel de arriba)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisées seulement quand vous jouez sur cet appareil. À la publication, les images sont retirées (les autres voient l'apparence du niveau ci-dessus)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur beim Spielen auf diesem Gerät verwendet. Beim Veröffentlichen werden die Bilder entfernt (andere sehen das oben gewählte Level-Aussehen)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usadas apenas quando você joga neste dispositivo. Ao publicar, as imagens são removidas (os outros veem o visual da fase acima)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используются только при игре на этом устройстве. При публикации изображения удаляются (другие видят внешний вид уровня, заданный выше)."
          }
        }
      }
    },
