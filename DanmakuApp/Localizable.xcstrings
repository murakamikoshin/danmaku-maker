        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Veröffentlichen schaffe das Level im Testspiel (nach Änderungen musst du es erneut schaffen)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
