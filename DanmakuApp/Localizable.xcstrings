          "stringUnit": {
            "state": "translated",
            "value": "A ring shaped like a heart."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハートの形に広がる輪。"
          }
        }
      }
    },
    "shop.pattern.homing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bullets that curve toward your ship (for 2.5 s after firing)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自機を追いかけて曲がる弾。曲がるのは出てから2.5秒だけ。"
