    "delete.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All stages you published, your likes, and your account data will be deleted permanently. To continue, sign in with Apple again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが投稿したステージ、いいね、アカウント情報がすべて削除され、元に戻せません。続けるには、Apple でもう一度サインインしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你发布的所有关卡、点赞和账号数据将被永久删除。如需继续,请再次使用 Apple 登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你釋出的所有關卡、點贊和賬號資料將被永久刪除。如需繼續,請再次使用 Apple 登入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 게시한 모든 스테이지, 좋아요, 계정 데이터가 영구적으로 삭제됩니다. 계속하려면 Apple로 다시 로그인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los niveles que publicaste, tus me gusta y los datos de tu cuenta se eliminarán de forma permanente. Para continuar, vuelve a iniciar sesión con Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les niveaux que vous avez publiés, vos « J'aime » et les données de votre compte seront définitivement supprimés. Pour continuer, reconnectez-vous avec Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle von dir veröffentlichten Level, deine Likes und deine Kontodaten werden dauerhaft gelöscht. Melde dich zum Fortfahren erneut mit Apple an."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as fases que você publicou, suas curtidas e os dados da sua conta serão excluídos permanentemente. Para continuar, entre novamente com a Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все опубликованные вами уровни, ваши лайки и данные аккаунта будут удалены безвозвратно. Чтобы продолжить, снова войдите через Apple."
          }
        }
      }
    },
    "delete.done.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and stages have been deleted. You can keep playing as a guest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントと投稿したステージを削除しました。ゲストとして遊び続けられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账号和关卡已被删除。你仍可以访客身份继续游玩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的賬號和關卡已被刪除。你仍可以訪客身份繼續遊玩。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정과 스테이지가 삭제되었어요. 게스트로 계속 플레이할 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta y tus niveles se eliminaron. Puedes seguir jugando como invitado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte et vos niveaux ont été supprimés. Vous pouvez continuer à jouer en tant qu'invité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto und deine Level wurden gelöscht. Du kannst als Gast weiterspielen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta e suas fases foram excluídas. Você pode continuar jogando como convidado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш аккаунт и уровни удалены. Вы можете продолжать играть как гость."
          }
        }
      }
    },
