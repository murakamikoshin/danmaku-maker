    "NSUserTrackingUsageDescription" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広告を表示するために使用します。許可しなくても遊べます。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to show ads. You can play without allowing it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于显示广告。即使不允许,也可以正常游玩。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於顯示廣告。即使不允許,也可以正常遊玩。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "광고를 표시하는 데 사용돼요. 허용하지 않아도 플레이할 수 있어요."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para mostrar anuncios. Puedes jugar sin permitirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé pour afficher des publicités. Vous pouvez jouer sans l'autoriser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird zum Anzeigen von Werbung verwendet. Du kannst auch ohne Erlaubnis spielen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para exibir anúncios. Você pode jogar sem permitir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для показа рекламы. Играть можно и без разрешения."
          }
        }
      }
    }
  }
